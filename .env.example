# Copier ce fichier vers .env puis renseigner les identifiants uniquement dans .env.
# Cluster0 du projet SportsEnsemble. Les valeurs entre < > sont a remplacer.
# Encoder les caracteres speciaux du mot de passe pour une URI (guide : ATLAS.md).
# Ce modele public ne contient aucun identifiant administrateur reel.
MONGODB_URI=mongodb+srv://<UTILISATEUR_ATLAS>:<MOT_DE_PASSE_ENCODE>@cluster0.kzatqc3.mongodb.net/?appName=SportsEnsemble
MONGODB_DB=sportsensemble
PORT=9010
APP_ORIGIN=http://localhost:9010

# Pour un serveur MongoDB local, remplacer MONGODB_URI dans .env par :
# mongodb://127.0.0.1:27017
